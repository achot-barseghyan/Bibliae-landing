# Formulaire de contact (/api/contact) — clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Expéditeur des messages ; le domaine doit être vérifié chez Resend
CONTACT_FROM=Bibliae <formulaire@bibliae.app>
# Anti-robots du formulaire : Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Sans ces deux clés, le formulaire fonctionne sans vérification.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
