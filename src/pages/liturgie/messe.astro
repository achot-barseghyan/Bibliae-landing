---
// Lecture de la messe du jour : rendue côté serveur pour que Google lise les textes (cache jusqu'à minuit).
import Base from '../../layouts/Base.astro';
import LwNav from '../../components/liturgie/LwNav.astro';
import LwFooter from '../../components/liturgie/LwFooter.astro';
import ChapeletPopup from '../../components/ChapeletPopup.astro';
import LwDayNav from '../../components/liturgie/LwDayNav.astro';
import { getInfo, getMasses, type Mass, type Reading } from '../../scripts/liturgie/aelf';
import { cap, title as dayTitle, type Title } from '../../scripts/liturgie/calendar';
import { HOUR_PAGES, cache, clip, gospelOf, longDate, pageDate, schema, unquote } from '../../scripts/liturgie/server';

export const prerender = false;

const { date, d, today, isToday } = pageDate(Astro.url);
const dateLabel = longDate(d);

let masses: Mass[] = [];
let t: Title | null = null;
try {
  const [info, ms] = await Promise.all([getInfo(date), getMasses(date)]);
  t = dayTitle(info, d);
  masses = ms.filter((m) => m.readings.length);
} catch {
  masses = [];
}
const ok = masses.length > 0;
cache(Astro.response.headers, ok);
if (!ok) Astro.response.status = 503;

const gospel = gospelOf(masses[0]);
// « Ps 84 (85), 9ab.10, 11-12 » → « Ps 84 (85) » : la description doit garder de la place pour l'Évangile
const refs = masses[0]?.readings.filter((r) => r.type !== 'evangile').map((r) => (r.type === 'psaume' ? r.ref.split(',')[0] : r.ref)).join(' ; ') ?? '';

const pageTitle = isToday ? `Lecture de la messe du jour — ${cap(dateLabel)} | Bibliae` : `Lectures de la messe du ${dateLabel} | Bibliae`;
// L'Évangile d'abord : c'est ce que l'on cherche le plus souvent
const description = ok
  ? clip(`${gospel ? `Évangile du jour (${gospel.ref}) : « ${unquote(gospel.title)} ». ` : ''}Lectures de la messe du ${dateLabel} : ${refs}. Textes officiels AELF.`)
  : `Les lectures de la messe du ${dateLabel} : première lecture, psaume et Évangile du jour.`;

const sid = (m: number, i: number) => (masses.length > 1 ? `m${m + 1}-` : '') + `l${i + 1}`;
const isPsalm = (r: Reading) => r.type === 'psaume' || r.type === 'cantique';
// Ancre stable « #evangile » pour l'Évangile de la première messe (liens depuis le site)
const anchor = (m: number, i: number, r: Reading) => (m === 0 && r === gospel ? 'evangile' : sid(m, i));
---

<Base
  title={pageTitle}
  description={description}
  ogTitle={isToday ? `Lecture de la messe du jour — ${dateLabel}` : `Lectures de la messe du ${dateLabel}`}
  ogDescription={description}
  noindex={!isToday}
  themeColor="#EFE7D3"
  schema={schema({
    url: '/liturgie/messe',
    name: isToday ? 'Lecture de la messe du jour' : `Lectures de la messe du ${dateLabel}`,
    description,
    date,
    crumbs: [['Accueil', '/'], ['Liturgie du jour', '/liturgie'], ['Lecture de la messe', '/liturgie/messe']],
  })}
>
  <LwNav />
  <main id="contenu" class="page">
    <div class="wrap">
      <nav class="crumbs" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a><span aria-hidden="true">›</span><a href="/liturgie">Liturgie du jour</a><span aria-hidden="true">›</span><span aria-current="page">Lecture de la messe</span>
      </nav>

      <header class="head">
        <p class="eyebrow">{t?.rank || 'Liturgie de la Parole'}</p>
        <h1>
          {isToday ? 'Lecture de la messe du jour' : 'Lectures de la messe'}
          <span class="date">{cap(dateLabel)}</span>
        </h1>
        {t && (
          <p class="day">
            {t.l1}
            {t.sup && <sup>{t.sup}</sup>} {t.l2 && <em>{t.l2}</em>}
          </p>
        )}
        {t?.memorial && <p class="memorial">{t.memorial}</p>}
        <LwDayNav path="/liturgie/messe" date={date} today={today} />
      </header>

      {
        !ok && (
          <p class="status">
            Les lectures n'ont pas pu être chargées pour le moment. <a href={`https://www.aelf.org/${date}/romain/messe`}>Les lire sur aelf.org</a>
          </p>
        )
      }

      <div class="layout">
        {
          ok && (
            <aside class="toc">
              <p class="toc-k">Sommaire</p>
              <ol>
                {masses.map((m, mi) => (
                  <>
                    {masses.length > 1 && <li class="toc-mass">{m.name}</li>}
                    {m.readings.map((r, i) => (
                      <li>
                        <a href={`#${anchor(mi, i, r)}`}>
                          <span class="t-label">{r.label}</span>
                          <span class="t-ref">{r.ref}</span>
                        </a>
                      </li>
                    ))}
                  </>
                ))}
              </ol>
            </aside>
          )
        }

        <article class="text">
          {
            masses.map((m, mi) => (
              <>
                {masses.length > 1 && <h2 class="mass-name">{m.name}</h2>}
                {m.readings.map((r, i) =>
                  r.type === 'evangile' ? (
                    <section class="reading gospel" id={anchor(mi, i, r)} aria-labelledby={`${anchor(mi, i, r)}-h`}>
                      <span class="cross" aria-hidden="true">✝</span>
                      {r.acclamation.length > 0 && (
                        <>
                          <p class="acc-k">Acclamation de l'Évangile{r.acclamationRef && ` · ${r.acclamationRef}`}</p>
                          <p class="acc">{r.acclamation.join('\n')}</p>
                        </>
                      )}
                      <h2 id={`${anchor(mi, i, r)}-h`} class="r-head">
                        <span class="r-label">{masses.length > 1 ? 'Évangile' : 'Évangile du jour'}</span>
                        <span class="r-ref">{r.ref}</span>
                      </h2>
                      {r.title && <p class="r-title">{r.title}</p>}
                      {r.intro && <p class="r-intro">{r.intro}</p>}
                      <div class="paras">{r.paras.map((p) => <p>{p}</p>)}</div>
                      <p class="close">
                        <span>— Acclamons la Parole de Dieu.</span>
                        <span><b>℟</b> Louange à toi, Seigneur Jésus.</span>
                      </p>
                    </section>
                  ) : (
                    <section class="reading" id={anchor(mi, i, r)} aria-labelledby={`${anchor(mi, i, r)}-h`}>
                      <h2 id={`${anchor(mi, i, r)}-h`} class="r-head">
                        <span class="r-label">{r.label}</span>
                        <span class="r-ref">{r.ref}</span>
                      </h2>
                      {r.title && !isPsalm(r) && <p class="r-title">{r.title}</p>}
                      {r.intro && <p class="r-intro">{r.intro}</p>}
                      {isPsalm(r) && r.refrain && (
                        <p class="refrain">
                          <span aria-hidden="true">℟</span> {r.refrain}
                        </p>
                      )}
                      <div class="paras">{r.paras.map((p) => <p>{p}</p>)}</div>
                      {!isPsalm(r) && r.type !== 'sequence' && (
                        <p class="close">
                          <span>— Parole du Seigneur.</span>
                          <span><b>℟</b> Nous rendons grâce à Dieu.</span>
                        </p>
                      )}
                    </section>
                  ),
                )}
              </>
            ))
          }

          <section class="next" aria-labelledby="next-h">
            <h2 id="next-h">Prier la liturgie des heures</h2>
            <p>Les psaumes, hymnes et lectures de l'office du {dateLabel}.</p>
            <ul>
              {HOUR_PAGES.map((h) => <li><a href={isToday ? `/liturgie/${h.slug}` : `/liturgie/${h.slug}?date=${date}`}>{h.name}</a></li>)}
            </ul>
          </section>
          <p class="source"><span aria-hidden="true">✦</span> Textes liturgiques © AELF — <a href="https://www.aelf.org">aelf.org</a></p>
        </article>
      </div>
    </div>
  </main>
  <LwFooter />
  <ChapeletPopup />
</Base>

<style>
  .page {
    background: var(--paper);
    color: var(--ink);
    padding: 110px var(--gutter) 120px;
  }
  .wrap {
    max-width: 1180px;
    margin: 0 auto;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 12px;
    color: rgba(35, 32, 26, 0.6);
  }
  .crumbs a {
    color: inherit;
  }
  .crumbs a:hover {
    color: var(--oxblood);
  }
  .head {
    margin-top: 34px;
    max-width: 820px;
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--oxblood);
  }
  h1 {
    margin-top: 14px;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(44px, 5.6vw, 80px);
    line-height: 0.98;
    color: var(--ink);
    text-wrap: balance;
  }
  .date {
    display: block;
    margin-top: 10px;
    font-style: italic;
    font-size: 0.5em;
    color: var(--oxblood);
  }
  .day {
    margin-top: 22px;
    font-family: var(--serif-text);
    font-size: 21px;
    color: rgba(35, 32, 26, 0.8);
  }
  .day sup {
    font-size: 0.6em;
    line-height: 0;
  }
  .memorial {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.55;
    color: rgba(35, 32, 26, 0.62);
  }
  .head :global(.daynav) {
    margin-top: 26px;
    max-width: 560px;
  }
  .status {
    margin-top: 40px;
    padding: 32px;
    border-radius: 20px;
    box-shadow: inset 0 0 0 0.5px rgba(35, 32, 26, 0.22);
    font-family: var(--serif-text);
    font-style: italic;
    font-size: 19px;
  }
  .status a {
    color: var(--oxblood);
    text-decoration: underline;
  }

  .layout {
    margin-top: 56px;
    display: flex;
    flex-wrap: wrap;
    gap: 40px 80px;
    align-items: flex-start;
  }
  .toc {
    flex: 0 1 240px;
    position: sticky;
    top: 110px;
  }
  .toc-k {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(35, 32, 26, 0.62);
  }
  .toc ol {
    margin-top: 18px;
    padding: 0 0 0 18px;
    border-left: 0.5px solid rgba(35, 32, 26, 0.28);
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .toc a {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .toc-mass {
    margin-top: 6px;
    font-family: var(--serif-text);
    font-style: italic;
    font-size: 15px;
    color: var(--oxblood);
  }
  .t-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--oxblood);
  }
  .t-ref {
    font-family: var(--serif-text);
    font-size: 16px;
    color: rgba(35, 32, 26, 0.7);
  }

  .text {
    flex: 1 1 560px;
    min-width: 0;
    max-width: 780px;
  }
  .mass-name {
    margin-top: 48px;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: 34px;
    color: var(--oxblood);
  }
  .mass-name:first-child {
    margin-top: 0;
  }
  .reading {
    padding: 40px 0 44px;
    border-top: 0.5px solid rgba(35, 32, 26, 0.22);
    scroll-margin-top: 100px;
  }
  .r-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    font-weight: 400;
  }
  .r-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--oxblood);
  }
  .r-ref {
    font-family: var(--serif-text);
    font-size: 18px;
    color: rgba(35, 32, 26, 0.7);
  }
  .r-title {
    margin-top: 16px;
    font-family: var(--serif);
    font-size: clamp(24px, 2.4vw, 30px);
    line-height: 1.25;
    text-wrap: pretty;
  }
  .r-intro {
    margin-top: 14px;
    font-family: var(--serif-text);
    font-style: italic;
    font-size: 19px;
    color: rgba(35, 32, 26, 0.72);
  }
  .refrain {
    margin-top: 22px;
    padding: 20px 24px;
    border-radius: 18px;
    background: var(--night-cream);
    box-shadow: inset 0 0 0 0.5px rgba(181, 137, 46, 0.6);
    font-family: var(--serif);
    font-style: italic;
    font-size: 25px;
    line-height: 1.3;
  }
  .refrain span {
    color: var(--gold);
    font-style: normal;
  }
  .paras {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .paras p {
    font-family: var(--serif);
    font-size: 25px;
    line-height: 1.45;
    white-space: pre-line;
    text-wrap: pretty;
  }
  .close {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--serif-text);
    font-size: 18px;
    color: rgba(35, 32, 26, 0.78);
  }
  .close b {
    font-weight: 400;
    color: var(--gold);
  }

  .gospel {
    position: relative;
    overflow: hidden;
    margin: 12px 0 40px;
    padding: 48px clamp(24px, 5vw, 56px) 50px;
    border-top: 0;
    border-radius: 28px;
    background: radial-gradient(90% 90% at 88% 0%, #3a1a1e 0%, var(--ink) 70%);
    color: var(--night-cream);
    box-shadow: 0 40px 70px -40px rgba(35, 32, 26, 0.9);
  }
  .gospel > * {
    position: relative;
  }
  .gospel .cross {
    position: absolute;
    right: -20px;
    top: -70px;
    font-family: var(--serif);
    font-size: 300px;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(240, 213, 142, 0.2);
    pointer-events: none;
  }
  .acc-k {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(240, 213, 142, 0.85);
  }
  .acc {
    margin: 10px 0 34px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 24px;
    line-height: 1.35;
    color: var(--night-gold);
    white-space: pre-line;
  }
  .gospel .r-label {
    color: var(--night-gold);
  }
  .gospel .r-ref,
  .gospel .r-intro {
    color: rgba(244, 237, 220, 0.75);
  }
  .gospel .close {
    color: rgba(244, 237, 220, 0.82);
  }
  .gospel .close b {
    color: var(--night-gold);
  }

  .next {
    margin-top: 40px;
    padding: 34px 36px;
    border-radius: 24px;
    background: var(--night);
    color: var(--night-cream);
  }
  .next h2 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: 36px;
  }
  .next p {
    margin-top: 6px;
    font-family: var(--serif-text);
    font-style: italic;
    font-size: 17px;
    color: rgba(244, 237, 220, 0.72);
  }
  .next ul {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .next a {
    min-height: 38px;
    padding: 0 16px;
    border-radius: 19px;
    display: inline-flex;
    align-items: center;
    box-shadow: inset 0 0 0 0.5px rgba(244, 237, 220, 0.4);
    font-family: var(--serif);
    font-style: italic;
    font-size: 19px;
    color: var(--night-cream);
  }
  .next a:hover {
    color: var(--night-gold);
  }
  .source {
    margin-top: 28px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(35, 32, 26, 0.62);
  }
  .source span {
    color: var(--gold);
  }
  .source a {
    color: inherit;
    text-decoration: underline;
  }

  @media (max-width: 899px) {
    .toc {
      display: none;
    }
    .paras p {
      font-size: 22px;
    }
  }
</style>
