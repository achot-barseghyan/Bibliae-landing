---
// Annonce du chapelet, montrée une seule fois (mémorisée dans localStorage).
// Rendue cachée : le script ne l'ouvre que pour les visiteurs qui ne l'ont pas encore vue.
import { Image, getImage } from 'astro:assets';
import marie from '../assets/rosaire/marie.png';
import medaille from '../assets/rosaire/medaille.png';
import pater from '../assets/rosaire/pater.png';
import vert from '../assets/rosaire/vert.png';
import rouge from '../assets/rosaire/rouge.png';
import jaune from '../assets/rosaire/jaune.png';
import bleu from '../assets/rosaire/bleu.png';
import violet from '../assets/rosaire/violet.png';
import { ROSARY_URL } from '../config';

const url = (src: ImageMetadata, width: number) => getImage({ src, width, format: 'webp' }).then((i) => `url(${i.src})`);
const imgs = [await url(vert, 48), await url(rouge, 48), await url(jaune, 48), await url(bleu, 48), await url(violet, 48)];
const paterImg = await url(pater, 64);

// Une dizaine en arc au-dessus de la médaille (repère 460 × 250)
const CX = 230, CY = 216, R = 168;
const angle = (t: number) => Math.PI + 0.32 + (Math.PI - 0.64) * t;
const beads = Array.from({ length: 11 }, (_, k) => {
  const a = angle(k / 10);
  const big = k === 0 || k === 10;
  return { x: ((CX + R * Math.cos(a)) / 460) * 100, y: ((CY + R * Math.sin(a) * 0.92) / 250) * 100, w: big ? 28 : 19, img: big ? paterImg : imgs[Math.floor((k - 1) / 2)] };
});
const arc = Array.from({ length: 61 }, (_, i) => {
  const a = angle(i / 60);
  return `${i ? 'L' : 'M'}${(CX + R * Math.cos(a)).toFixed(1)} ${(CY + R * Math.sin(a) * 0.92).toFixed(1)}`;
}).join(' ');
---

<div class="cp" data-cp hidden>
  <div class="cp-shade" data-cp-close data-cp-shade></div>
  <div class="cp-card" data-cp-card role="dialog" aria-modal="true" aria-labelledby="cp-title" tabindex="-1">
    <div class="cp-art">
      <svg class="cp-spin" viewBox="0 0 460 460" fill="none" aria-hidden="true"><circle cx="230" cy="230" r="226" stroke="#B5892E" stroke-width="0.6" opacity="0.3"></circle><circle cx="230" cy="230" r="214" stroke="#B5892E" stroke-width="0.6" opacity="0.25" stroke-dasharray="2 9"></circle></svg>
      <Image class="cp-mary" src={marie} alt="" widths={[128, 256]} sizes="128px" loading="lazy" />
      <svg class="cp-arc" viewBox="0 0 460 250" aria-hidden="true"><path data-cp-thread d={arc} pathLength="1"></path></svg>
      {beads.map((b) => <span class="cp-bead" data-cp-bead aria-hidden="true" style={`left:${b.x}%;top:${b.y}%;width:${b.w}px;height:${b.w}px;background-image:${b.img}`} />)}
      <Image class="cp-medal" data-cp-medal src={medaille} alt="" widths={[46, 92]} sizes="46px" loading="lazy" />

      <button class="cp-x" type="button" data-cp-close aria-label="Fermer">
        <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12"></path></svg>
      </button>
      <span class="cp-new"><span class="cp-dot"></span>Nouveau</span>
    </div>

    <div class="cp-body">
      <h2 class="cp-title" id="cp-title" data-cp-in="1">Le chapelet <em>est arrivé</em></h2>
      <p class="cp-text" data-cp-in="2">Priez le chapelet grain après grain, directement sur Bibliae, avec les mystères du jour.</p>
      <p class="cp-today" data-cp-in="3">
        <span class="cp-day" data-cp-day></span>
        <span class="cp-sep" aria-hidden="true"></span>
        <span class="cp-set">Mystères <span data-cp-set></span></span>
      </p>
      <div class="cp-actions" data-cp-in="4">
        <a class="cp-go" href={ROSARY_URL} data-cp-go>
          Prier le chapelet
          <svg width="16" height="12" viewBox="0 0 14 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 6h11.5M8 1.5 12.5 6 8 10.5"></path></svg>
          <span class="cp-sheen" aria-hidden="true"></span>
        </a>
        <button class="cp-later" type="button" data-cp-close>Plus tard</button>
      </div>
    </div>
  </div>
</div>

<style>
  .cp {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .cp[hidden] {
    display: none;
  }
  .cp-shade {
    position: absolute;
    inset: 0;
    background: rgba(8, 6, 4, 0.62);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .cp-card {
    position: relative;
    width: 100%;
    max-width: 460px;
    max-height: calc(100vh - 40px);
    max-height: calc(100dvh - 40px);
    overflow: auto;
    scrollbar-width: none;
    overscroll-behavior: contain;
    border-radius: 28px;
    background: var(--ink-dark);
    box-shadow:
      0 50px 100px -30px rgba(0, 0, 0, 0.85),
      inset 0 0 0 0.5px rgba(226, 190, 110, 0.4);
  }
  .cp-card:focus {
    outline: none;
  }

  /* ---------- Illustration ---------- */
  .cp-art {
    position: relative;
    height: 250px;
    overflow: hidden;
    border-radius: 28px 28px 0 0;
    background: radial-gradient(70% 80% at 50% 70%, rgba(181, 137, 46, 0.28), rgba(107, 30, 35, 0.14) 55%, transparent 80%);
  }
  .cp-spin {
    position: absolute;
    left: 50%;
    top: 205px;
    width: 460px;
    height: 460px;
    max-width: none;
    margin: -230px 0 0 -230px;
    pointer-events: none;
    animation: cp-rot 120s linear infinite;
  }
  @keyframes cp-rot {
    to {
      transform: rotate(360deg);
    }
  }
  .cp-mary {
    position: absolute;
    left: 50%;
    top: 58px;
    width: 128px;
    height: auto;
    margin-left: -64px;
    opacity: 0.55;
    mix-blend-mode: screen;
    -webkit-mask-image: linear-gradient(180deg, #000 40%, transparent 88%);
    mask-image: linear-gradient(180deg, #000 40%, transparent 88%);
    pointer-events: none;
    animation: cp-float 6s ease-in-out infinite alternate;
  }
  @keyframes cp-float {
    from {
      transform: translateY(-4px);
    }
    to {
      transform: translateY(4px);
    }
  }
  .cp-arc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .cp-arc path {
    fill: none;
    stroke: var(--gold-light);
    stroke-width: 1.4;
    stroke-dasharray: 1 1;
    filter: drop-shadow(0 0 3px rgba(226, 190, 110, 0.8));
  }
  .cp-bead {
    position: absolute;
    transform: translate(-50%, -50%);
    background: center / contain no-repeat;
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.5));
  }
  .cp-medal {
    position: absolute;
    left: 50%;
    top: 216px;
    width: 46px;
    height: auto;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.6));
  }
  .cp-x {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(21, 18, 14, 0.5);
    box-shadow: inset 0 0 0 0.5px rgba(247, 241, 227, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--paper-light);
    cursor: pointer;
    transition: background 0.3s;
  }
  .cp-x:hover {
    background: rgba(247, 241, 227, 0.12);
  }
  .cp-new {
    position: absolute;
    top: 18px;
    left: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 28px;
    padding: 0 12px;
    border-radius: 14px;
    background: rgba(21, 18, 14, 0.5);
    box-shadow: inset 0 0 0 0.5px rgba(226, 190, 110, 0.55);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-light);
  }
  .cp-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold-light);
    animation: cp-ping 1.8s infinite;
  }
  @keyframes cp-ping {
    from {
      box-shadow: 0 0 0 0 rgba(226, 190, 110, 0.7);
    }
    to {
      box-shadow: 0 0 0 7px rgba(226, 190, 110, 0);
    }
  }

  /* ---------- Texte ---------- */
  .cp-body {
    padding: 22px 32px 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .cp-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 40px;
    line-height: 1;
    color: var(--paper-light);
  }
  .cp-title em {
    color: var(--gold-light);
  }
  .cp-text {
    margin-top: 14px;
    max-width: 340px;
    font-family: var(--serif-text);
    font-size: 18px;
    line-height: 1.55;
    color: rgba(247, 241, 227, 0.78);
    text-wrap: pretty;
  }
  .cp-today {
    margin-top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 34px;
    padding: 0 14px;
    border-radius: 17px;
    background: rgba(247, 241, 227, 0.05);
    box-shadow: inset 0 0 0 0.5px rgba(247, 241, 227, 0.2);
  }
  .cp-day {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(247, 241, 227, 0.6);
  }
  .cp-sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(247, 241, 227, 0.4);
  }
  .cp-set {
    font-family: var(--serif);
    font-style: italic;
    font-size: 18px;
    color: var(--gold-light);
  }
  .cp-actions {
    margin-top: 24px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .cp-go {
    position: relative;
    overflow: hidden;
    min-height: 56px;
    border-radius: 28px 28px 8px 8px;
    background: var(--gold-light);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dark);
    box-shadow: 0 14px 30px -14px rgba(226, 190, 110, 0.8);
    transition: background 0.3s;
  }
  .cp-go:hover {
    background: var(--night-gold);
    color: var(--ink-dark);
  }
  .cp-sheen {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 80px;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    pointer-events: none;
    animation: cp-sheen 4.8s ease-in-out infinite;
  }
  @keyframes cp-sheen {
    0%,
    55% {
      transform: translateX(-120px);
    }
    100% {
      transform: translateX(520px);
    }
  }
  .cp-later {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--serif-text);
    font-style: italic;
    font-size: 16px;
    color: rgba(247, 241, 227, 0.6);
    cursor: pointer;
  }
  .cp-later:hover {
    color: var(--paper-light);
  }

  @media (max-width: 419px) {
    .cp-body {
      padding-left: 22px;
      padding-right: 22px;
    }
    .cp-title {
      font-size: 34px;
    }
  }
</style>

<script>
  import { DAYS, SETS, todaySet } from '../scripts/chapelet/data';

  const SEEN = 'bibliae.popup.chapelet.vu';
  const EASE = 'cubic-bezier(.2,.7,.2,1)';
  const root = document.querySelector<HTMLElement>('[data-cp]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let seen = false;
  try {
    seen = !!localStorage.getItem(SEEN);
  } catch {
    /* stockage bloqué : on montre l'annonce */
  }

  if (root && !seen) {
    const q = <T extends Element = HTMLElement>(s: string) => Array.from(root.querySelectorAll<T & HTMLElement>(s));
    const card = q('[data-cp-card]')[0];
    const shade = q('[data-cp-shade]')[0];
    const markSeen = () => {
      try {
        localStorage.setItem(SEEN, '1');
      } catch {
        /* navigation privée */
      }
    };

    // Mystères du jour (avec l'Avent et le Carême, comme le réglage par défaut de la page)
    const wd = new Date().getDay();
    q('[data-cp-day]')[0].textContent = DAYS[wd];
    q('[data-cp-set]')[0].textContent = SETS[todaySet(true)].adj;

    const before = document.activeElement as HTMLElement | null;
    root.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    card.focus({ preventScroll: true });

    if (!reduced) {
      shade.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 500, fill: 'backwards' });
      card.animate([{ opacity: 0, transform: 'translateY(30px) scale(0.96)', filter: 'blur(8px)' }, { opacity: 1, transform: 'none', filter: 'blur(0)' }], { duration: 900, delay: 120, easing: EASE, fill: 'backwards' });
      q('[data-cp-in]').forEach((el) =>
        el.animate([{ opacity: 0, transform: 'translateY(14px)' }, { opacity: 1, transform: 'none' }], { duration: 800, delay: 500 + Number(el.dataset.cpIn) * 110, easing: EASE, fill: 'backwards' }),
      );
      q<SVGPathElement>('[data-cp-thread]').forEach((el) => el.animate([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 1600, delay: 400, easing: EASE, fill: 'both' }));
      // Les grains apparaissent un à un, puis une lueur les parcourt en boucle
      const rest = { filter: 'drop-shadow(0 2px 3px rgba(0,0,0,0.5))', transform: 'translate(-50%,-50%) scale(1)' };
      q('[data-cp-bead]').forEach((el, k) => {
        el.animate([{ opacity: 0, transform: 'translate(-50%,-50%) scale(0.3)' }, { opacity: 1, transform: 'translate(-50%,-50%) scale(1)' }], { duration: 600, delay: 450 + k * 120, easing: 'cubic-bezier(.3,1.6,.5,1)', fill: 'backwards' });
        el.animate([rest, { filter: 'brightness(1.25) drop-shadow(0 0 8px rgba(255,214,120,1))', transform: 'translate(-50%,-50%) scale(1.3)', offset: 0.04 }, { ...rest, offset: 0.1 }, rest], { duration: 5500, delay: 2200 + k * 300, iterations: Infinity, easing: 'ease-in-out' });
      });
      q('[data-cp-medal]').forEach((el) => el.animate([{ opacity: 0, transform: 'translate(-50%,-30%) scale(0.6)' }, { opacity: 1, transform: 'translate(-50%,-50%) scale(1)' }], { duration: 800, delay: 300, easing: EASE, fill: 'backwards' }));
    }

    const done = () => {
      root.hidden = true;
      document.documentElement.style.overflow = '';
      root.getAnimations({ subtree: true }).forEach((a) => a.cancel());
      before?.focus({ preventScroll: true });
    };
    let closing = false;
    const close = () => {
      if (closing) return;
      closing = true;
      markSeen();
      document.removeEventListener('keydown', onKey);
      if (reduced) return done();
      shade.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 400, fill: 'forwards' });
      card.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateY(20px) scale(0.97)', filter: 'blur(6px)' }], { duration: 400, easing: EASE, fill: 'forwards' }).onfinish = done;
    };

    // Échap ferme ; Tab reste dans la fenêtre
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') return close();
      if (e.key !== 'Tab') return;
      const f = q('button, a[href]');
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && (document.activeElement === first || document.activeElement === card)) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };
    document.addEventListener('keydown', onKey);
    q('[data-cp-close]').forEach((el) => el.addEventListener('click', close));
    q('[data-cp-go]')[0].addEventListener('click', markSeen);
  }
</script>
