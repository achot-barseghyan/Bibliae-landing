---
// Cadre de téléphone 300×620 (260×538 sous 400 px). Le contenu de l'écran passe par le slot.
interface Props {
  /** hero : ombre sombre + liseré or · light : ombre douce pour fond papier */
  tone?: 'hero' | 'light';
  class?: string;
}
const { tone = 'hero', class: className } = Astro.props;
---

<div class:list={['phone', tone, className]}>
  <div class="screen">
    <div class="notch" aria-hidden="true"></div>
    <slot />
  </div>
</div>

<style>
  .phone {
    width: 300px;
    height: 620px;
    border-radius: 50px;
    background: var(--phone);
    padding: 11px;
  }
  .phone.hero {
    box-shadow:
      0 50px 100px -20px rgba(0, 0, 0, 0.75),
      0 0 0 1px rgba(226, 190, 110, 0.25),
      inset 0 0 0 2px #2a251e;
  }
  .phone.light {
    box-shadow:
      0 40px 80px -24px rgba(35, 32, 26, 0.55),
      inset 0 0 0 2px #2a251e;
  }
  .screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 40px;
    background: var(--paper);
    overflow: hidden;
  }
  .notch {
    position: absolute;
    top: 10px;
    left: 50%;
    width: 96px;
    height: 28px;
    margin-left: -48px;
    border-radius: 14px;
    background: var(--phone);
    z-index: 9;
  }
  @media (max-width: 399px) {
    .phone {
      width: 260px;
      height: 538px;
      border-radius: 44px;
      padding: 10px;
    }
    .screen {
      border-radius: 35px;
    }
  }
</style>
