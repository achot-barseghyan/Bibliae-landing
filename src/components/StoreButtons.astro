---
// ⚠️ En production, remplacer ces dessins par les badges officiels Apple et Google
// (obligatoires selon leurs règles de marque).
import { IOS, ANDROID, APP_STORE_URL, PLAY_STORE_URL } from '../config';

interface Props {
  /** hero : 58 px, Google Play en contour · cta : 62 px, Google Play sur fond sombre */
  variant?: 'hero' | 'cta';
}

const { variant = 'hero' } = Astro.props;
const shine = variant === 'hero' ? [0, 1600] : [400, 2000];
const playRed = variant === 'hero' ? '#8E3A3F' : '#B34A50';

const stores = [
  {
    key: 'apple',
    href: APP_STORE_URL,
    live: IOS.live,
    top: { live: 'Télécharger dans', soon: `Le ${IOS.label} dans` },
    name: "l'App Store",
  },
  {
    key: 'play',
    href: PLAY_STORE_URL,
    live: ANDROID.live,
    top: { live: 'Disponible sur', soon: 'Bientôt sur' },
    name: 'Google Play',
  },
];
---

<div class:list={['stores', variant]}>
  {
    stores.map((s, i) => {
      const soon = !s.live;
      const Tag = soon ? 'span' : 'a';
      const attrs = soon
        ? {} // pas encore sorti sur ce store : pas de lien
        : { href: s.href, rel: 'noopener' };
      return (
        <Tag class:list={['store', s.key, { soon }]} {...attrs}>
          {s.key === 'apple' ? (
            <svg class="logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.37 12.6c-.02-2.3 1.88-3.4 1.97-3.46-1.07-1.57-2.74-1.78-3.33-1.8-1.42-.14-2.77.83-3.49.83-.72 0-1.83-.81-3.01-.79-1.55.02-2.98.9-3.78 2.29-1.61 2.8-.41 6.94 1.16 9.21.77 1.11 1.68 2.36 2.88 2.31 1.16-.05 1.59-.75 2.99-.75 1.4 0 1.79.75 3.01.72 1.24-.02 2.03-1.13 2.79-2.25.88-1.29 1.24-2.54 1.26-2.6-.03-.01-2.42-.93-2.45-3.71zM14.08 5.84c.64-.77 1.07-1.85.95-2.92-.92.04-2.03.61-2.69 1.38-.59.68-1.11 1.78-.97 2.83 1.02.08 2.07-.52 2.71-1.29z" />
            </svg>
          ) : (
            <svg class="logo" viewBox="0 0 22 24" aria-hidden="true">
              <path d="M1 1.2l11.4 10.8L1 22.8c-.3-.2-.5-.6-.5-1.1V2.3c0-.5.2-.9.5-1.1z" fill="#E2BE6E" />
              <path d="M16 8.6l-3.6 3.4L16 15.4l4.2-2.4c1.1-.6 1.1-1.6 0-2.2L16 8.6z" fill="#F7F1E3" />
              <path d="M12.4 12L1 1.2c.4-.3 1-.3 1.6.1L16 8.6 12.4 12z" fill="#C9A04A" />
              <path d="M12.4 12L16 15.4 2.6 22.7c-.6.4-1.2.4-1.6.1L12.4 12z" fill={playRed} />
            </svg>
          )}
          <span class="txt">
            <span class="top">{s.top[soon ? 'soon' : 'live']}</span>
            <span class="name">{s.name}</span>
          </span>
          <span class="shine" data-shine style={`--shine-delay:${shine[i]}ms`} aria-hidden="true" />
        </Tag>
      );
    })
  }
</div>

<style>
  .stores {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .stores.cta {
    justify-content: center;
  }

  .store {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 58px;
    padding: 0 22px 0 18px;
    border-radius: 14px;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s,
      background 0.3s;
  }
  .cta .store {
    min-height: 62px;
    padding: 0 24px 0 20px;
    border-radius: 15px;
  }
  .store.soon {
    opacity: 0.82;
    cursor: default;
  }

  .apple,
  .apple:hover {
    background: var(--paper-light);
    color: var(--ink-dark);
  }
  .play,
  .play:hover {
    color: var(--paper-light);
  }
  .hero .play {
    background: transparent;
    box-shadow: inset 0 0 0 1px rgba(247, 241, 227, 0.45);
  }
  .cta .play {
    background: var(--ink-dark);
  }

  .hero a.store:hover {
    transform: translateY(-3px);
  }
  .hero a.apple:hover {
    box-shadow: 0 14px 30px rgba(226, 190, 110, 0.28);
  }
  .hero a.play:hover {
    background: rgba(247, 241, 227, 0.08);
  }
  .cta a.store:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.35);
  }

  .logo {
    flex: none;
  }
  .apple .logo {
    width: 24px;
    height: 24px;
  }
  .play .logo {
    width: 22px;
    height: 24px;
  }
  .cta .apple .logo {
    width: 26px;
    height: 26px;
  }
  .cta .play .logo {
    width: 23px;
    height: 25px;
  }

  .txt {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    text-align: left;
  }
  .top {
    font-size: 10.5px;
    font-weight: 500;
  }
  .cta .top {
    font-size: 11px;
  }
  .play .top {
    color: rgba(247, 241, 227, 0.75);
  }
  .name {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .cta .name {
    font-size: 19px;
  }

  .shine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 40%;
    transform: translateX(-150%);
    pointer-events: none;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.75), transparent);
  }
  .play .shine {
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.22), transparent);
  }

  @media (max-width: 399px) {
    .store {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
