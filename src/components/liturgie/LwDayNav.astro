---
// Veille / lendemain d'une page de texte. Les jours autres qu'aujourd'hui ne sont pas indexés (voir les pages).
import { addDays, iso, parse } from '../../scripts/liturgie/calendar';

interface Props {
  path: string;
  date: string;
  today: string;
  tone?: 'paper' | 'night';
}
const { path, date, today, tone = 'paper' } = Astro.props;
const href = (iso2: string) => (iso2 === today ? path : `${path}?date=${iso2}`);
const day = parse(date);
const short = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
const prev = addDays(day, -1), next = addDays(day, 1);
---

<nav class:list={['daynav', tone]} aria-label="Changer de jour">
  <a href={href(iso(prev))} rel="nofollow"><span aria-hidden="true">←</span> {short.format(prev)}</a>
  {date !== today && <a class="today" href={path}>Aujourd'hui</a>}
  <a href={href(iso(next))} rel="nofollow">{short.format(next)} <span aria-hidden="true">→</span></a>
</nav>

<style>
  .daynav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .daynav a {
    min-height: 40px;
    padding: 0 16px;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--serif-text);
    font-style: italic;
    font-size: 16px;
  }
  .paper a {
    box-shadow: inset 0 0 0 0.5px rgba(35, 32, 26, 0.35);
    color: var(--ink);
  }
  .paper a:hover {
    color: var(--oxblood);
  }
  .night a {
    box-shadow: inset 0 0 0 0.5px rgba(244, 237, 220, 0.35);
    color: var(--night-cream);
  }
  .night a:hover {
    color: var(--night-gold);
  }
  .today {
    font-style: normal !important;
    font-family: var(--sans) !important;
    font-size: 11px !important;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
