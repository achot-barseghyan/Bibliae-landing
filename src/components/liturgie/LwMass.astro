---
// Lecture du jour : sommaire fixe à gauche, cartes des lectures, Évangile révélé mot à mot. Rempli par page.ts.
---

<section id="lecture" class="mass" aria-labelledby="mass-title">
  <div class="inner">
    <div class="side">
      <p class="eyebrow" data-rv="0">Lecture du jour</p>
      <h2 id="mass-title" data-rv="1">La messe</h2>
      <p class="short" data-rv="2" data-mass-short>&nbsp;</p>
      <div class="choice" data-rv="2" data-mass-choice role="group" aria-label="Choisir la messe" hidden></div>
      <nav class="toc" data-rv="3" aria-label="Lectures de la messe">
        <span class="rail" aria-hidden="true"></span>
        <span class="thread" data-thread aria-hidden="true"></span>
        <ol data-toc></ol>
      </nav>
      <button class="read" type="button" data-rv="4" data-open-mass disabled>Lire la messe <span class="arrow" aria-hidden="true">→</span></button>
    </div>

    <div class="cards" data-readings>
      <p class="status" data-mass-status>Chargement des lectures…</p>
      <div data-cards></div>

      <article id="r-ev" class="gospel" data-rv="0" data-read hidden>
        <span class="cross" aria-hidden="true">✝</span>
        <div class="head">
          <span class="label">Évangile</span>
          <span class="ref" data-gospel-ref></span>
        </div>
        <p class="words" data-gospel-words></p>
        <div class="btns">
          <button class="gbtn" type="button" data-open-gospel>Lire l'Évangile <span class="arrow" aria-hidden="true">→</span></button>
          <a class="gbtn ghost" href="#heures">Prier les heures</a>
        </div>
      </article>
      <p class="source" data-rv="0"><span aria-hidden="true">✦</span> Textes liturgiques · <a href="https://www.aelf.org" rel="noopener">AELF</a></p>
    </div>
  </div>
</section>

<style>
  .mass {
    position: relative;
    background: var(--paper);
    padding: 120px var(--gutter) 130px;
  }
  .inner {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 72px;
    align-items: flex-start;
  }
  .side {
    flex: 0 1 330px;
    position: sticky;
    top: 110px;
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--oxblood);
  }
  h2 {
    margin-top: 16px;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(54px, 5.4vw, 84px);
    line-height: 0.95;
    color: var(--ink);
  }
  .short {
    margin-top: 12px;
    font-family: var(--serif-text);
    font-style: italic;
    font-size: 19px;
    color: rgba(35, 32, 26, 0.72);
  }
  .choice {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .choice :global(button) {
    min-height: 34px;
    padding: 0 14px;
    border: 0;
    border-radius: 17px;
    background: transparent;
    box-shadow: inset 0 0 0 0.5px rgba(35, 32, 26, 0.4);
    cursor: pointer;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .choice :global(button[aria-pressed='true']) {
    background: var(--ink);
    color: var(--night-gold);
  }

  .toc {
    position: relative;
    margin-top: 38px;
    padding-left: 30px;
  }
  .rail,
  .thread {
    position: absolute;
    top: 8px;
    bottom: 8px;
  }
  .rail {
    left: 5px;
    width: 0.5px;
    background: rgba(35, 32, 26, 0.28);
  }
  .thread {
    left: 4.5px;
    width: 1.5px;
    background: linear-gradient(180deg, var(--gold), var(--oxblood));
    transform-origin: top;
    transform: scaleY(0);
  }
  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .toc :global(a) {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .toc :global(.t-dot) {
    position: absolute;
    left: -30px;
    top: 5px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px rgba(35, 32, 26, 0.4);
    transition: all 0.5s var(--ease);
  }
  .toc :global(.t-label) {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(35, 32, 26, 0.6);
    transition: color 0.4s;
  }
  .toc :global(.t-ref) {
    font-family: var(--serif-text);
    font-size: 17px;
    color: rgba(35, 32, 26, 0.7);
  }
  .toc :global(li.on .t-label) {
    color: var(--oxblood);
  }
  .toc :global(li.on .t-dot) {
    background: var(--gold);
    box-shadow: none;
  }
  .toc :global(li.cur .t-dot) {
    background: var(--oxblood);
    box-shadow: 0 0 0 5px rgba(107, 30, 35, 0.16);
  }

  .read {
    margin-top: 42px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 54px;
    padding: 0 26px;
    border: 0;
    border-radius: 27px;
    background: var(--ink);
    cursor: pointer;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--night-gold);
    transition:
      gap 0.3s,
      transform 0.3s;
  }
  .read:hover:not(:disabled) {
    gap: 18px;
    transform: translateY(-2px);
  }
  .read:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .arrow {
    font-family: var(--serif);
    font-size: 20px;
    letter-spacing: 0;
  }

  .cards {
    flex: 1 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .cards > div {
    display: contents;
  }
  .status {
    padding: 48px;
    border-radius: 24px;
    box-shadow: inset 0 0 0 0.5px rgba(35, 32, 26, 0.22);
    font-family: var(--serif-text);
    font-style: italic;
    font-size: 19px;
    color: rgba(35, 32, 26, 0.7);
  }
  .status:empty {
    display: none;
  }
  .status :global(a) {
    color: var(--oxblood);
    text-decoration: underline;
  }

  .cards :global(.card) {
    position: relative;
    overflow: hidden;
    padding: 48px 48px 50px;
    border-radius: 24px;
    background: var(--night-cream);
    box-shadow: inset 0 0 0 0.5px rgba(35, 32, 26, 0.22);
    scroll-margin-top: 110px;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s;
  }
  .cards :global(.card:hover) {
    transform: translateY(-4px);
    box-shadow:
      inset 0 0 0 1px rgba(181, 137, 46, 0.7),
      0 30px 50px -36px rgba(35, 32, 26, 0.6);
  }
  .cards :global(.c-mark) {
    position: absolute;
    right: 28px;
    top: -34px;
    font-family: var(--serif);
    font-weight: 300;
    font-size: 200px;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(181, 137, 46, 0.35);
    pointer-events: none;
  }
  .cards :global(.c-head),
  .head {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }
  .cards :global(.c-label) {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--oxblood);
  }
  .cards :global(.c-ref) {
    font-family: var(--serif-text);
    font-size: 18px;
    color: rgba(35, 32, 26, 0.7);
  }
  .cards :global(.c-q) {
    position: relative;
    margin-top: 20px;
    max-width: 720px;
    font-family: var(--serif);
    font-size: clamp(28px, 2.6vw, 38px);
    line-height: 1.28;
    color: var(--ink);
    text-wrap: pretty;
  }

  .gospel {
    position: relative;
    overflow: hidden;
    padding: 56px 52px 54px;
    border-radius: 28px;
    background: radial-gradient(90% 90% at 88% 0%, #3a1a1e 0%, var(--ink) 70%);
    box-shadow: 0 40px 70px -40px rgba(35, 32, 26, 0.9);
    scroll-margin-top: 110px;
  }
  .cross {
    position: absolute;
    right: -20px;
    top: -70px;
    font-family: var(--serif);
    font-size: 340px;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(240, 213, 142, 0.22);
    pointer-events: none;
    animation: breath 9s ease-in-out infinite;
  }
  .label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--night-gold);
  }
  .ref {
    font-family: var(--serif-text);
    font-size: 18px;
    color: rgba(244, 237, 220, 0.72);
  }
  .words {
    position: relative;
    margin-top: 24px;
    max-width: 820px;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.26em;
    font-family: var(--serif);
    font-size: clamp(34px, 3.4vw, 52px);
    line-height: 1.22;
    color: var(--night-cream);
  }
  .words :global(span) {
    opacity: 0.14;
    filter: blur(2px);
    transition:
      opacity 0.35s,
      filter 0.35s;
  }
  .words :global(span.on) {
    opacity: 1;
    filter: none;
  }
  .btns {
    position: relative;
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .gbtn {
    min-height: 52px;
    padding: 0 24px;
    border: 0;
    border-radius: 26px;
    background: var(--night-gold);
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .gbtn:hover {
    background: #f4dfa4;
    color: var(--ink);
  }
  .gbtn .arrow {
    color: var(--oxblood);
  }
  .ghost {
    padding: 0 22px;
    background: transparent;
    box-shadow: inset 0 0 0 0.5px rgba(244, 237, 220, 0.45);
    font-weight: 500;
    color: var(--night-cream);
  }
  .ghost:hover {
    background: transparent;
    color: var(--night-gold);
  }

  .source {
    margin-top: 6px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 8px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(35, 32, 26, 0.62);
  }
  .source span {
    font-family: var(--serif);
    font-size: 14px;
    color: var(--gold);
  }
  .source a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @keyframes breath {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.08);
    }
  }

  /* Sur une colonne, le sommaire n'a plus de raison d'être fixe */
  @media (max-width: 999px) {
    .side {
      position: relative;
      top: 0;
    }
    .inner {
      gap: 48px;
    }
  }
  @media (max-width: 599px) {
    .cards :global(.card) {
      padding: 34px 26px 36px;
    }
    .gospel {
      padding: 40px 26px 40px;
    }
  }
</style>
